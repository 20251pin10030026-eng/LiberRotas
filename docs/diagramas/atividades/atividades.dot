 falha [label="Informar falha sem
duplicar lançamento",fillcolor="#FCE8E8"];
 fim [shape=doublecircle,label="",width=.22,height=.22,fillcolor="#067F84",color="#067F84"];
 inicio->escolher->validar->checa;
 checa->rejeita [label="não"]; rejeita->fim;
 checa->confirma [label="sim"]; confirma->atomic->ok;
 ok->sucesso [label="sim"]; ok->falha [label="não"];
 sucesso->fim; falha->fim;
