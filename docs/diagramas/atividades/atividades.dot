 node [shape=box,fillcolor="#F8FAFC",color="#8CA7B7", fontsize=11];
 inicio [shape=circle, label="",width=.20, height=.20,fillcolor="#067F84",color="#067F84"];
 escolher [label="Visitante escolhe oferta
