 group [label="{GrupoInstitucional|id: texto\lstatus: texto\l}"];
 membership [label="{VinculoInstitucional|id: texto\lstatus: texto\l}"];
 conversation [label="{Conversa|id: texto\ltipo: texto\l}"];
 message [label="{Mensagem|id: texto\lremetenteId: texto\ltexto: texto\l}"];
 account -> institution [label="0..1", arrowhead=empty,style=dashed];
 merchant -> product [label="1 -> 0..*",arrowhead=vee];
