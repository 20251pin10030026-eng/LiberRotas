 node [shape=record, fillcolor="#E8EFF7", color="#7DAAB5", fontsize=10];
 account [label="{Conta|uid: texto\lperfil: texto\lstatus: texto\l}"];
 merchant [label="{Empreendedor|uid: texto\lestabelecimento: texto\lstatus: texto\l}"];
 product [label="{Produto|id: texto\ltitulo: texto\lprecoCentavos: inteiro\lestoque: inteiro\l}"];
 offer [label="{OfertaAoVivo|id: texto\lprodutoId: texto\lvalidade: data/hora\llimiteResgates: inteiro\l}"];
